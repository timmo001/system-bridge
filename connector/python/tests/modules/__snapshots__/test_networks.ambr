# serializer version: 1
# name: test_networks
  Networks(
    connections=list([
      NetworkConnection(
        family=2,
        fd=1,
        laddr='laddr',
        pid=4,
        raddr='raddr',
        status='status',
        type=3,
      ),
    ]),
    io=NetworkIO(
      bytes_recv=2,
      bytes_recv_rate=10.5,
      bytes_sent=1,
      bytes_sent_rate=9.5,
      dropin=7,
      dropout=8,
      errin=5,
      errout=6,
      packets_recv=4,
      packets_sent=3,
    ),
    networks=list([
      Network(
        addresses=list([
          NetworkAddress(
            address='address',
            broadcast='broadcast',
            family=None,
            netmask='netmask',
            ptp='ptp',
          ),
        ]),
        io=NetworkIO(
          bytes_recv=12,
          bytes_recv_rate=20.5,
          bytes_sent=11,
          bytes_sent_rate=19.5,
          dropin=17,
          dropout=18,
          errin=15,
          errout=16,
          packets_recv=14,
          packets_sent=13,
        ),
        name='name',
        stats=NetworkStats(
          duplex='duplex',
          flags=list([
            'flag1',
            'flag2',
          ]),
          isup=True,
          mtu=2,
          speed=1,
        ),
        wifi=NetworkWifi(
          link_rate=866.7,
          signal=-55,
          signal_percent=90,
          ssid='ssid',
        ),
      ),
    ]),
  )
