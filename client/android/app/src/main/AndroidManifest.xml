<?xml version="1.0" encoding="utf-8"?>
<!--
  System Bridge's manifest: its activity with the share and deep link intent
  filters, the Lock and Sleep tiles, the camera for scanning a pairing code,
  and the local network, which Android 17 gates for apps that target it and
  without which neither the computer's page nor the tiles can reach it. The
  shell's own manifest adds the internet and notifications. The app's push
  service replaces the shell's, so it can name each push's computer and
  press its buttons on it. Media controls run as a media playback service.
-->
<manifest
  xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:tools="http://schemas.android.com/tools">
  <uses-permission android:name="android.permission.CAMERA" />
  <uses-permission android:name="android.permission.ACCESS_LOCAL_NETWORK" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />

  <application
    android:icon="@mipmap/ic_launcher"
    android:label="@string/app_name"
    android:networkSecurityConfig="@xml/network_security_config"
    android:supportsRtl="true"
    android:theme="@style/Theme.Groundwork.Shell">
    <meta-data android:name="groundwork.devUrl" android:value="${devUrl}" />

    <activity
      android:name=".MainActivity"
      android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode|density"
      android:exported="true"
      android:launchMode="singleTask">
      <intent-filter>
        <action android:name="android.intent.action.MAIN" />
        <category android:name="android.intent.category.LAUNCHER" />
      </intent-filter>
      <intent-filter>
        <action android:name="android.intent.action.SEND" />
        <category android:name="android.intent.category.DEFAULT" />
        <data android:mimeType="text/plain" />
      </intent-filter>
      <intent-filter>
        <action android:name="android.intent.action.VIEW" />
        <category android:name="android.intent.category.DEFAULT" />
        <category android:name="android.intent.category.BROWSABLE" />
        <data android:scheme="systembridge" />
      </intent-filter>
    </activity>

    <!-- The app's own push service, which names each push's computer and
         shows its buttons, in place of the shell's -->
    <service
      android:name="dev.timmo.groundwork.shell.ShellPushService"
      tools:node="remove" />
    <service
      android:name=".PushService"
      android:exported="false">
      <intent-filter>
        <action android:name="org.unifiedpush.android.connector.PUSH_EVENT" />
      </intent-filter>
    </service>
    <receiver
      android:name=".PressReceiver"
      android:exported="false" />

    <!-- Media controls for the computer's player, which the system binds to -->
    <service
      android:name=".MediaControlService"
      android:exported="true"
      android:foregroundServiceType="mediaPlayback">
      <intent-filter>
        <action android:name="androidx.media3.session.MediaSessionService" />
      </intent-filter>
    </service>

    <service
      android:name=".LockTileService"
      android:exported="true"
      android:icon="@drawable/ic_tile_lock"
      android:label="@string/tile_lock"
      android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
      <intent-filter>
        <action android:name="android.service.quicksettings.action.QS_TILE" />
      </intent-filter>
    </service>

    <service
      android:name=".SleepTileService"
      android:exported="true"
      android:icon="@drawable/ic_tile_sleep"
      android:label="@string/tile_sleep"
      android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
      <intent-filter>
        <action android:name="android.service.quicksettings.action.QS_TILE" />
      </intent-filter>
    </service>
  </application>
</manifest>
