{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "system-bridge-client",
  "compatibility_date": "2026-07-17",
  "workers_dev": true,
  "preview_urls": true,
  "routes": [
    {
      "pattern": "system-bridge-client.timmo.dev",
      "custom_domain": true,
    },
  ],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
  },
}
