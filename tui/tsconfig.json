{
  "$schema": "./node_modules/@effect/language-service/schema.json",
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "outDir": "dist",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "types": ["bun"],
    "plugins": [
      { "name": "@effect/language-service", "ignoreEffectWarningsInTscExitCode": true }
    ]
  },
  "include": ["src/**/*.ts"]
}
