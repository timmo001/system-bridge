{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["github>timmo001/renovate-config"],
  "customDatasources": {
    "home-assistant-python": {
      "defaultRegistryUrlTemplate": "https://raw.githubusercontent.com/home-assistant/core/master/pyproject.toml",
      "format": "toml",
      "transformTemplates": [
        "{\"releases\": [{\"version\": $substringAfter(project.`requires-python`, \">=\")}], \"sourceUrl\": \"https://github.com/home-assistant/core\"}"
      ]
    },
    "home-assistant-python-minor": {
      "defaultRegistryUrlTemplate": "https://raw.githubusercontent.com/home-assistant/core/master/pyproject.toml",
      "format": "toml",
      "transformTemplates": [
        "{\"releases\": [{\"version\": $join($split($substringAfter(project.`requires-python`, \">=\"), \".\")[[0..1]], \".\")}], \"sourceUrl\": \"https://github.com/home-assistant/core\"}"
      ]
    },
    "home-assistant-aiohttp": {
      "defaultRegistryUrlTemplate": "https://raw.githubusercontent.com/home-assistant/core/master/pyproject.toml",
      "format": "toml",
      "transformTemplates": [
        "{\"releases\": [{\"version\": $substringAfter(project.dependencies[$substringBefore($, \"==\") = \"aiohttp\"], \"==\")}], \"sourceUrl\": \"https://github.com/aio-libs/aiohttp\"}"
      ]
    }
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "Keep annotated versions in step with the latest Home Assistant release.",
      "managerFilePatterns": [
        "/(^|/)pyproject\\.toml$/",
        "/(^|/)mise\\.toml$/",
        "/(^|/)\\.github/workflows/[^/]+\\.ya?ml$/"
      ],
      "matchStrings": [
        "#\\s*renovate:\\s*datasource=(?<datasource>custom\\.home-assistant-[a-z-]+)\\s+depName=(?<depName>\\S+)\\s*\\n[^\\n]*?(?<currentValue>\\d+\\.\\d+(?:\\.\\d+)?)\""
      ],
      "versioningTemplate": "pep440"
    }
  ],
  "packageRules": [
    {
      "description": "Update every Python version that follows Home Assistant together.",
      "matchDatasources": [
        "custom.home-assistant-python",
        "custom.home-assistant-python-minor"
      ],
      "groupName": "Home Assistant Python",
      "groupSlug": "home-assistant-python",
      "minimumReleaseAge": null
    },
    {
      "description": "aiohttp follows Home Assistant's pin, not the latest release.",
      "matchDatasources": ["pypi"],
      "matchPackageNames": ["aiohttp"],
      "enabled": false
    },
    {
      "description": "Python in mise follows Home Assistant, not the latest Python release.",
      "matchManagers": ["github-actions", "mise"],
      "matchDepNames": ["python"],
      "enabled": false
    },
    {
      "description": "Normalize Go tags from golang/go.",
      "matchDatasources": ["github-tags"],
      "matchPackageNames": ["golang/go"],
      "extractVersion": "^go(?<version>.*)$",
      "versioning": "semver"
    },
    {
      "description": "Normalize Node tags from nodejs/node.",
      "matchDatasources": ["github-tags"],
      "matchPackageNames": ["nodejs/node"],
      "extractVersion": "^v(?<version>.*)$",
      "versioning": "node"
    },
    {
      "description": "Include Lit lint plugins in the shared Oxlint group.",
      "groupName": "oxlint",
      "matchPackageNames": ["eslint-plugin-lit", "eslint-plugin-wc"]
    },
    {
      "description": "Group Tailwind CSS packages.",
      "groupName": "tailwindcss",
      "matchPackageNames": [
        "tailwindcss",
        "@tailwindcss/**",
        "tailwind-merge",
        "postcss"
      ]
    }
  ]
}
