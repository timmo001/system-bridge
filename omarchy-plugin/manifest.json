{
  "schemaVersion": 1,
  "id": "timmo.system-bridge",
  "name": "System Bridge",
  "version": "2.2.0",
  "author": "Timmo",
  "license": "Apache-2.0",
  "description": "Local system data and controls from System Bridge",
  "kinds": [
    "service",
    "bar-widget"
  ],
  "keepLoaded": true,
  "entryPoints": {
    "service": "Service.qml",
    "barWidget": "BarWidget.qml"
  },
  "barWidget": {
    "displayName": "System Bridge",
    "description": "Shows CPU and memory, with a panel for every System Bridge module",
    "category": "Info",
    "allowMultiple": false,
    "defaultSection": "right",
    "defaults": {
      "primaryOnly": false,
      "primaryOutput": ""
    },
    "schema": [
      {
        "key": "primaryOnly",
        "type": "boolean",
        "label": "Primary output only",
        "defaultValue": false
      },
      {
        "key": "primaryOutput",
        "type": "string",
        "label": "Primary output",
        "defaultValue": "",
        "description": "Optional output name used when primary output only is enabled."
      }
    ]
  }
}
